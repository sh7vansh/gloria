# Gloria Configuration
# Copy to .env and customize as needed

# ── Display ─────────────────────────────────────────────────
GLORIA_DISPLAY=:1
GLORIA_SCREEN_WIDTH=1920
GLORIA_SCREEN_HEIGHT=1080
GLORIA_SCREEN_DEPTH=24

# ── Network Ports ───────────────────────────────────────────
# VNC (internal to Docker network, not exposed to host by default)
GLORIA_VNC_PORT=5901

# MCP Proxy (exposed to host)
GLORIA_MCP_PORT=8787

# noVNC web interface (exposed to host)
GLORIA_WEB_PORT=8080

# ── Persistent Storage ──────────────────────────────────────
GLORIA_DATA=/data

# ── VNC Password ────────────────────────────────────────────
# Password for direct VNC connections
GLORIA_VNC_PASSWORD=gloria

